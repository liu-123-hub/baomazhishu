{
  "name": "mom-index-cross-platform",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "宝妈指数 - 跨平台金融情绪分析系统 (Web/Desktop/Mobile)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode web",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "build:pwa": "vite build --mode pwa",
    "preview": "vite preview",
    "dev:mobile": "vite --mode mobile --host",
    "build:mobile": "vite build --mode mobile",
    "electron:dev": "cross-env VITE_DEV_PORT=5174 concurrently -k \"vite --mode electron\" \"wait-on http://localhost:5174 && electron .\"",
    "electron:build:web": "vite build --mode electron",
    "electron:pack": "npm run electron:build:web && node electron/pack.cjs",
    "electron:pack:web": "vite build --mode electron && node electron/pack.cjs",
    "electron:dist": "npm run electron:build:web && electron-builder",
    "electron:dist:win": "npm run electron:build:web && electron-builder --win",
    "electron:dist:mac": "npm run electron:build:web && electron-builder --mac",
    "electron:dist:linux": "npm run electron:build:web && electron-builder --linux",
    "tauri": "tauri",
    "dev:tauri": "tauri dev",
    "build:tauri": "tauri build",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:build:android": "npm run build:mobile && cap sync android && cap open android",
    "cap:build:ios": "npm run build:mobile && cap sync ios && cap open ios"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@capacitor/core": "^6.1.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.13.0",
    "sass": "^1.78.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.momindex.app",
    "productName": "宝妈指数",
    "directories": {
      "output": "release/electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Finance"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
